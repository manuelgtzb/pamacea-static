{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/Home/Index", "destination": "/", "permanent": true },
    { "source": "/Home/Enfermedades", "destination": "/prevencion/", "permanent": true },
    { "source": "/Home/Anatomia", "destination": "/anatomia/", "permanent": true },
    { "source": "/Home/SaludMental", "destination": "/salud-mental/", "permanent": true },
    { "source": "/Home/Ayuda", "destination": "/recursos/", "permanent": true },
    { "source": "/Home/LineaDeVida", "destination": "/linea-de-vida/", "permanent": true },
    { "source": "/Home/ProgramaVerificados", "destination": "/profesionales/", "permanent": true },
    { "source": "/Home/AcercaDe", "destination": "/creditos/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|webp|ico|glb|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
