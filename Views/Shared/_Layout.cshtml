@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var resourcesActive = currentAction is "Ayuda" or "LineaDeVida" or "ProgramaVerificados" or "AcercaDe";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PAMACEA: información clara sobre salud, prevención, anatomía y bienestar para jóvenes y familias." />
    <meta name="theme-color" content="#f4fbfa" />
    <title>@ViewData["Title"] | PAMACEA</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Manrope:wght@600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/acerca.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/interfaz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header" id="top">
        <div class="nav-shell">
            <a asp-controller="Home" asp-action="Index" class="brand" aria-label="Ir al inicio de PAMACEA">
                <img src="~/images/Logo.png" alt="" class="site-logo" />
                <span class="brand-copy">
                    <strong>PAMACEA</strong>
                    <small>Salud que puedes entender</small>
                </span>
            </a>

            <button class="menu-toggle" id="menuBtn" type="button" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <nav class="main-nav" id="sidebar" aria-label="Navegación principal">
                <a class="nav-link @(currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="nav-link @(currentAction == "Enfermedades" ? "active" : "")" asp-controller="Home" asp-action="Enfermedades">Prevención</a>
                <a class="nav-link @(currentAction == "Anatomia" ? "active" : "")" asp-controller="Home" asp-action="Anatomia">Anatomía</a>
                <a class="nav-link @(currentAction == "SaludMental" ? "active" : "")" asp-controller="Home" asp-action="SaludMental">Salud mental</a>
                <a class="nav-link nav-link-more @(resourcesActive ? "active" : "")" asp-controller="Home" asp-action="Ayuda">Recursos</a>
            </nav>

            <button class="nav-ai-button" type="button" data-open-sofia>
                <span class="status-dot"></span>
                Preguntar a SofIA
            </button>
        </div>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-shell">
            <div class="footer-brand">
                <img src="~/images/Logo.png" alt="" />
                <div><strong>PAMACEA</strong><span>Información para cuidar de ti y de los tuyos.</span></div>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Ayuda">Directorio de ayuda</a>
                <a asp-controller="Home" asp-action="LineaDeVida">Línea de vida</a>
                <a asp-controller="Home" asp-action="ProgramaVerificados">Profesionales</a>
                <a asp-controller="Home" asp-action="AcercaDe">El proyecto</a>
            </div>
            <p class="medical-note"><strong>Importante:</strong> PAMACEA brinda orientación educativa y no sustituye una consulta, diagnóstico o tratamiento médico.</p>
        </div>
        <div class="footer-bottom">
            <span>PAMACEA · 2026</span>
            <span class="footer-powered">Impulsado por <img src="~/images/LogoRoma.png" alt="RomaLabs" /></span>
        </div>
    </footer>

    <div id="chat-widget-container" class="chat-widget-container" role="dialog" aria-modal="false" aria-labelledby="sofia-title" aria-hidden="true">
        <div class="chat-header-widget">
            <div class="header-content">
                <span class="sofia-avatar"><img src="~/images/BotonIA2.png" alt="" /></span>
                <div><strong id="sofia-title">SofIA</strong><small><span class="status-dot"></span> Asistente informativa</small></div>
            </div>
            <button id="close-chat-btn" class="close-btn" type="button" aria-label="Cerrar asistente">&times;</button>
        </div>
        <div class="chat-safety-note">No compartas datos personales. En una emergencia, llama al 911.</div>
        <div id="widget-chat-history" class="chat-history-widget" aria-live="polite">
            <div class="message ai-message"><div class="message-content">¡Hola! Soy SofIA. Puedo orientarte con información general sobre salud, prevención y bienestar. ¿Qué te gustaría conocer?</div></div>
        </div>
        <div class="chat-input-area-widget">
            <label class="sr-only" for="widget-user-input">Escribe tu pregunta</label>
            <input type="text" id="widget-user-input" placeholder="Escribe tu pregunta sobre salud…" autocomplete="off" />
            <div class="input-actions">
                <button id="sound-btn" class="icon-btn" type="button" title="Activar o desactivar sonido"><img src="~/images/soundon.png" alt="Sonido" id="sound-icon" /></button>
                <button id="mic-btn" class="icon-btn" type="button" title="Dictar pregunta"><img src="~/images/micon.png" alt="Micrófono" id="mic-icon" /></button>
                <button id="widget-send-btn" type="button" aria-label="Enviar pregunta">➜</button>
            </div>
        </div>
    </div>

    <button id="chat-toggle-btn" class="chat-toggle-btn" type="button" aria-label="Abrir asistente SofIA" data-open-sofia>
        <img src="~/images/BotonIA2.png" alt="" />
        <span><strong>SofIA</strong><small>Pregunta aquí</small></span>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/menu.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
